{
  "name": "studybridge",
  "productName": "StudyBridge",
  "version": "1.0.0",
  "description": "A private tutoring portal: tutors assign, learners work, marks and progress in one place.",
  "author": "StudyBridge",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack:connector": "node scripts/pack-connector.mjs",
    "dist": "npm run build && npm run pack:connector && electron-builder --publish never",
    "test": "node --test test/db.test.mjs test/fake-supabase.test.mjs test/steps.test.mjs test/connector.test.mjs test/prof.test.mjs",
    "walkthrough": "npm run build && node test/walkthrough.mjs",
    "icons": "node scripts/make-icons.mjs",
    "product": "npm run build && node test/product.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@cortex-js/compute-engine": "^0.140.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "livekit-client": "^2.22.3",
    "marked": "^18.0.14",
    "mathlive": "^0.110.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "app.studybridge.desktop",
    "productName": "StudyBridge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/studybridge.mcpb",
        "to": "studybridge.mcpb"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray.png",
        "to": "tray.png"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "StudyBridge uses your camera for live lessons, photos of your work, and exams your tutor has set to camera mode.",
        "NSMicrophoneUsageDescription": "StudyBridge uses your microphone in live lessons.",
        "NSScreenCaptureUsageDescription": "StudyBridge shares your screen in live lessons and camera-mode exams."
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "StudyBridge-Setup-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "StudyBridge-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
